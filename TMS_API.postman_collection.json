    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"tickets.create\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"employee_code\": \"EMP001\",\n    \"email_address\": \"employee@example.com\",\n    \"category\": \"IT Support\",\n    \"subject\": \"Laptop is not connecting to Wi-Fi\",\n    \"problem_description\": \"The laptop connects but shows no internet access.\",\n    \"priority\": \"High\",\n    \"assigned_to\": \"IT Helpdesk\",\n    \"customer\": \"Head Office\",\n    \"status\": \"Open\",\n    \"stage\": \"New\",\n    \"kanban_state\": \"To Do\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Requires an existing employee. Ticket ID and timestamps are generated."
          },
          "response": []
        },
        {
          "name": "Get Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"tickets.get\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"ticket_id\": \"TKT-2026-000001\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": ""
          },
          "response": []
        },
        {
          "name": "List Tickets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"tickets.list\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"status\": \"Open\",\n    \"priority\": \"High\",\n    \"query\": \"network\",\n    \"offset\": 0,\n    \"limit\": 50\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Optional filters: employee_code, status, priority, assigned_to, category. limit max is 200."
          },
          "response": []
        },
        {
          "name": "Update Ticket",
          "request": {
            "method": "POST",
