              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"employees.listAll\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {}\n}",
              "options": {
