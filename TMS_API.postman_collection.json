              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"employees.delete\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"employee_code\": \"EMP001\"\n  }\n}",
