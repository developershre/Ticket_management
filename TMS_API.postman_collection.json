    },
    {
      "name": "Reminders",
      "description": "Reminder API. Supports optional CC recipients (cc_emails) and grouped digest emails. When more than five due pending reminders exist for one employee, they are combined into one email with a separate secure ticket link for each reminder.",
      "item": [
        {
          "name": "Create Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.create\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"employee_code\": \"EMP001\",\n    \"service_category\": \"IT Support\",\n    \"reminder_message\": \"Please raise a ticket if your laptop/network issue is still unresolved.\",\n    \"send_at\": \"2026-12-01T10:00:00+05:30\",\n    \"cc_emails\": [\n      \"it.manager@example.com\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Optional cc_emails accepts an array or comma/semicolon-separated email string. Due reminders send immediately; future reminders use the five-minute worker. More than five due pending reminders for the same employee are sent together as one digest email. Replace the example CC address and scheduled date with real values before sending."
          },
          "response": []
        },
        {
          "name": "Get Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.get\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"reminder_id\": \"RMD-20261031-00001\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Fetch one reminder by reminder_id."
          },
          "response": []
        },
        {
          "name": "List Reminders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.list\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"status\": \"Pending\",\n    \"employee_code\": \"EMP001\",\n    \"offset\": 0,\n    \"limit\": 50\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Optional filters: employee_code, status, service_category, query. Pagination is supported."
          },
          "response": []
        },
        {
          "name": "Update Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.update\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"reminder_id\": \"RMD-20261031-00001\",\n    \"reminder_message\": \"Updated reminder message.\",\n    \"send_at\": \"2026-11-02T10:00:00+05:30\",\n    \"status\": \"Pending\",\n    \"cc_emails\": [\n      \"it.manager@example.com\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Update any supported reminder field. Add cc_emails to replace CC recipients; pass an empty string or empty array to clear CC."
          },
          "response": []
        },
        {
          "name": "Send Reminder Now (Secure Form Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.sendNow\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"reminder_id\": \"{{reminder_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Sends the secure ticket form email. If more than five eligible pending reminders exist for this employee, they are combined into one digest. Use force=true only to intentionally resend."
          },
          "response": []
        }
      ]
    }
  ]
}
