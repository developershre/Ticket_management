    {
      "name": "Reminders",
      "description": "Reminder API. Create schedules a reminder; it does not send immediately. Scheduled delivery requires the Apps Script time-driven trigger for sendDueReminderEmails. Use Send Reminder Now only to test mail delivery; the current API implementation sends a plain diagnostic email without the secure form URL.",
      "item": [
        {
          "name": "Create Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.create\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"employee_code\": \"EMP001\",\n    \"service_category\": \"IT Support\",\n    \"reminder_message\": \"Please raise a ticket if your laptop/network issue is still unresolved.\",\n    \"send_at\": \"2026-11-01T10:00:00+05:30\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Creates reminder. If send_at is in the past or present, the API attempts immediate secure-form email delivery and returns data.delivery. Future reminders are sent by the five-minute trigger. A saved reminder remains in the sheet if immediate delivery fails."
          },
          "response": []
        },
        {
          "name": "Get Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.get\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"reminder_id\": \"RMD-20261031-00001\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Fetch one reminder by reminder_id."
          },
          "response": []
        },
        {
          "name": "List Reminders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.list\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"status\": \"Pending\",\n    \"employee_code\": \"EMP001\",\n    \"offset\": 0,\n    \"limit\": 50\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Optional filters: employee_code, status, service_category, query. Pagination is supported."
          },
          "response": []
        },
        {
          "name": "Update Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.update\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"reminder_id\": \"RMD-20261031-00001\",\n    \"reminder_message\": \"Updated reminder message.\",\n    \"send_at\": \"2026-11-02T10:00:00+05:30\",\n    \"status\": \"Pending\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Update employee_code, service_category, reminder_message, send_at, and/or status. Status can be Pending or Cancelled. Completed reminders are system-managed."
          },
          "response": []
        },
        {
          "name": "Send Reminder Now (Secure Form Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"v1\",\n  \"action\": \"reminders.sendNow\",\n  \"auth\": {\n    \"api_key\": \"{{api_key}}\"\n  },\n  \"request_id\": \"{{$guid}}\",\n  \"data\": {\n    \"reminder_id\": \"{{reminder_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}",
            "description": "Sends the selected pending reminder immediately using the same secure Create Support Ticket form link as the scheduled worker. Respects once-per-day duplicate prevention; optionally add data.force=true to deliberately resend."
          },
          "response": []
        }
      ]
    }
  ]
}
