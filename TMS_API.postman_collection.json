{
  "info": {
    "_postman_id": "a8f70d42-2e6b-4bb2-bdb2-7a4d7d5a0101",
    "name": "Ticket Management System API v1 - Complete (Reminder Email Fixed)",
    "description": "Complete TMS API. Set base_url and api_key collection variables. Reminder create sends immediately for past/current send_at; future reminders use the five-minute worker. reminders.sendNow sends the secure ticket form link.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "PASTE_GENERATED_API_KEY_HERE",
      "type": "secret"
    },
    {
      "key": "reminder_id",
      "value": "RMD-REPLACE-WITH-REAL-ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
