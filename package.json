{
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./tailwind.css -o ./assets/tailwind.css",
    "watch": "npx @tailwindcss/cli -i ./tailwind.css -o ./assets/tailwind.css --watch",
    "bundle:msi": "npm run build && dx bundle --package-types msi --desktop -r"
  }
}
